# Copy to .env and fill in. .env is git-ignored; never commit real values.

# URL-safe characters only (it is embedded in a connection string)
POSTGRES_PASSWORD=change-me
# 24+ characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder is rejected at startup on purpose.
MJM_SERVICE_TOKEN=change-me

# Only for the LLM-backed agent and evals (console.anthropic.com; a claude.ai plan does not include API access)
ANTHROPIC_API_KEY=
MJM_LLM_MODEL=claude-sonnet-5-5

# Production auth: point at your IdP instead of the dev JWKS file
# MJM_OIDC_ISSUER=https://your-tenant.auth0.com/
# MJM_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
